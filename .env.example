# ============================================================
#  Острів Кай-Нуї — приклад файлу оточення
#  Скопіюй:  copy .env.example .env
# ============================================================

# --- База даних (обов'язково) ---
# За замовчуванням — SQLite (файл, без Docker/Postgres):
DATABASE_URL="file:./dev.db"

# Або PostgreSQL (якщо хочеш):
# DATABASE_URL="postgresql://kai:kai@localhost:5432/kai_nui?schema=public"
# і в prisma/schema.prisma постав provider = "postgresql"

# --- Ключ для ШІ: генерація тексту гри (ОБОВ'ЯЗКОВО) ---
# https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY="встав_свій_ключ"

# --- Ключ для ШІ: аналіз (НЕОБОВ'ЯЗКОВО) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-any-random-string"

# Set to 1 if DeepSeek has no balance (use Gemini only)
DEEPSEEK_DISABLED=0

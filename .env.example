# ============================================================
#  Острів Кай-Нуї — приклад файлу оточення
#  Скопіюй цей файл у ".env" і встав свої значення.
#  cp .env.example .env
# ============================================================

# --- База даних (обов'язково) ---
# Локальний PostgreSQL (див. LOCAL_SETUP.md, крок 3):
DATABASE_URL="postgresql://kai:kai@localhost:5432/kai_nui?schema=public"

# --- Ключ для ШІ: генерація тексту гри (ОБОВ'ЯЗКОВО) ---
# Головна модель, яка генерує весь текст гри — DeepSeek.
# Отримати ключ: https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY="встав_свій_ключ"

# --- Ключ для ШІ: аналіз відповідей (НЕОБОВ'ЯЗКОВО) ---
# Gemini використовується для фонового аналізу (оновлення статів тощо).
# Якщо порожній або вичерпаний — гра автоматично перемикається на DeepSeek.
# Отримати ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY="встав_свій_ключ_або_залиш_порожнім"

# --- NextAuth (потрібно лише якщо додаси авторизацію) ---
# NEXTAUTH_SECRET="будь-який_довгий_випадковий_рядок"
# NEXTAUTH_URL="http://localhost:3000"
